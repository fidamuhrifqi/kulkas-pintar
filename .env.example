# Token Bot Telegram (Dapatkan dari @BotFather di Telegram)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# API Key untuk LLM (Contoh menggunakan MiniMax API)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Keamanan: Masukkan ID Telegram Anda (pisahkan dengan koma jika lebih dari satu)
# Dapatkan ID Anda melalui bot @userinfobot di Telegram
ALLOWED_USER_IDS=123456789,987654321

# Model AI yang digunakan
MODEL_LIGHT=MiniMax-M2.5
MODEL_HEAVY=MiniMax-M2.7

# Kapasitas memori obrolan (chat history size)
CHAT_MEMORY_SIZE=20

# [Opsional] Matikan pembuatan folder __pycache__ yang mengganggu
PYTHONDONTWRITEBYTECODE=1
